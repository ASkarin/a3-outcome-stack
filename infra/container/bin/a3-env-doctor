#!/opt/a3/.venv/bin/python
from __future__ import annotations

import argparse
import json
import os
import pwd
import sys
import urllib.request
from pathlib import Path
from typing import Any

for candidate in (
    Path("/usr/local/lib/a3-container"),
    Path(__file__).resolve().parents[1] / "lib",
):
    if candidate.is_dir():
        sys.path.insert(0, str(candidate))
        break

from a3_container_common import (  # noqa: E402
    A3_ROOT,
    IMAGE_MANIFEST,
    MIN_FREE_BYTES,
    MIN_SHM_BYTES,
    MIRROR_ENDPOINT,
    WARN_FREE_BYTES,
    A3ContainerError,
    free_bytes,
    gpu_inventory,
    load_json,
    load_runtime_config,
    sha256_file,
    total_bytes,
    validate_digest,
)

ENDPOINTS = (
    "https://pypi.org/simple/",
    "https://download.pytorch.org/whl/cu128/",
    MIRROR_ENDPOINT,
)


def add_check(
    checks: list[dict[str, Any]],
    name: str,
    status: str,
    detail: Any,
) -> None:
    checks.append({"name": name, "status": status, "detail": detail})


def check_network(url: str) -> tuple[str, str]:
    request = urllib.request.Request(
        url,
        method="HEAD",
        headers={"User-Agent": "a3-env-doctor/1"},
    )
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            code = response.status
    except Exception as exc:  # Network errors have several platform-specific types.
        return "fail", f"{type(exc).__name__}: {exc}"
    return ("pass", f"HTTP {code}") if 200 <= code < 400 else ("fail", f"HTTP {code}")


def main() -> int:
    parser = argparse.ArgumentParser(description="Validate the A3 training container")
    parser.add_argument("--json", action="store_true", dest="as_json")
    parser.add_argument("--repo", type=Path, default=Path.cwd())
    parser.add_argument("--skip-network", action="store_true")
    args = parser.parse_args()

    checks: list[dict[str, Any]] = []

    try:
        runtime = load_runtime_config()
        add_check(checks, "runtime_config", "pass", runtime)
    except A3ContainerError as exc:
        runtime = {}
        add_check(checks, "runtime_config", "fail", str(exc))

    try:
        image_digest = validate_digest(os.environ.get("A3_IMAGE_DIGEST", ""))
        add_check(checks, "image_digest", "pass", image_digest)
    except A3ContainerError as exc:
        add_check(checks, "image_digest", "fail", str(exc))

    try:
        manifest = load_json(IMAGE_MANIFEST)
        add_check(checks, "image_manifest", "pass", manifest)
    except A3ContainerError as exc:
        manifest = {}
        add_check(checks, "image_manifest", "fail", str(exc))

    repo_lock = args.repo / "uv.lock"
    if repo_lock.is_file() and manifest.get("uv_lock_sha256"):
        actual_lock_hash = sha256_file(repo_lock)
        expected_lock_hash = manifest["uv_lock_sha256"]
        status = "pass" if actual_lock_hash == expected_lock_hash else "fail"
        add_check(
            checks,
            "uv_lock",
            status,
            {"actual": actual_lock_hash, "expected": expected_lock_hash},
        )
    else:
        add_check(checks, "uv_lock", "fail", f"missing lock or manifest hash at {repo_lock}")

    try:
        shm_bytes = total_bytes(Path("/dev/shm"))
        add_check(
            checks,
            "shared_memory",
            "pass" if shm_bytes >= MIN_SHM_BYTES else "fail",
            {"available_bytes": shm_bytes, "minimum_bytes": MIN_SHM_BYTES},
        )
    except OSError as exc:
        add_check(checks, "shared_memory", "fail", str(exc))

    try:
        workspace_free = free_bytes(Path("/workspace"))
        disk_status = (
            "fail"
            if workspace_free < MIN_FREE_BYTES
            else "warn"
            if workspace_free < WARN_FREE_BYTES
            else "pass"
        )
        add_check(
            checks,
            "workspace_free",
            disk_status,
            {
                "available_bytes": workspace_free,
                "warning_bytes": WARN_FREE_BYTES,
                "minimum_bytes": MIN_FREE_BYTES,
            },
        )
    except OSError as exc:
        add_check(checks, "workspace_free", "fail", str(exc))

    try:
        gpus = gpu_inventory()
        add_check(checks, "gpus", "pass" if len(gpus) == 3 else "fail", gpus)
    except A3ContainerError as exc:
        add_check(checks, "gpus", "fail", str(exc))

    current_user = pwd.getpwuid(os.getuid()).pw_name
    allowed_users = {runtime.get("admin_user"), runtime.get("collaborator_user")}
    add_check(
        checks,
        "current_user",
        "pass" if current_user in allowed_users else "fail",
        {"current": current_user, "allowed": sorted(user for user in allowed_users if user)},
    )

    required_directories = [
        (A3_ROOT / "staging" / current_user, True),
        (A3_ROOT / "runs" / current_user, True),
        (A3_ROOT / "releases" / "datasets", False),
        (A3_ROOT / "releases" / "models", False),
        (A3_ROOT / "cache", True),
        (A3_ROOT / "locks", True),
        (
            Path("/workspace/projects/a3-outcome-stack"),
            current_user == runtime.get("admin_user"),
        ),
    ]
    for directory, expected_writable in required_directories:
        exists = directory.is_dir()
        readable = os.access(directory, os.R_OK)
        writable = os.access(directory, os.W_OK)
        add_check(
            checks,
            f"directory:{directory}",
            "pass" if exists and readable and writable == expected_writable else "fail",
            {
                "exists": exists,
                "readable": readable,
                "writable": writable,
                "expected_writable": expected_writable,
            },
        )

    if not args.skip_network:
        for endpoint in ENDPOINTS:
            status, detail = check_network(endpoint)
            add_check(checks, f"network:{endpoint}", status, detail)

    overall = "fail" if any(item["status"] == "fail" for item in checks) else "pass"
    payload = {"schema_version": 1, "status": overall, "checks": checks}
    if args.as_json:
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        for item in checks:
            print(f"{item['status'].upper():4} {item['name']}: {item['detail']}")
        print(f"OVERALL: {overall.upper()}")
    return 0 if overall == "pass" else 1


if __name__ == "__main__":
    raise SystemExit(main())
