# Copy to infra/container/.env, replace every CHANGE_ME value, and chmod 0600.
A3_IMAGE=ghcr.io/askarin/a3-outcome-stack-env:CHANGE_ME
A3_WORKSPACE_HOST=/CHANGE_ME/a3-outcome-stack/workspace
A3_SSH_HOST_KEYS_HOST=/CHANGE_ME/a3-outcome-stack/ssh-host-keys
A3_AUTH_KEYS_HOST=/CHANGE_ME/a3-outcome-stack/authorized-keys
A3_SSH_BIND=0.0.0.0:22022

A3_ADMIN_USER=CHANGE_ME
A3_ADMIN_UID=CHANGE_ME
A3_COLLAB_USER=CHANGE_ME
A3_COLLAB_UID=CHANGE_ME
A3_GROUP_GID=CHANGE_ME
